# ============================================================
# AI 小镇 - 环境变量模板
# 使用方法：cp .env.example .env，并按实际情况填写
# 真实密钥禁止提交到仓库
# ============================================================

# ------------------------------
# 应用通用
# ------------------------------
APP_ENV=dev
APP_NAME=virtual-town
APP_LOG_LEVEL=INFO
APP_DEBUG=true

# ------------------------------
# 后端服务
# ------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_PUBLIC_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# ------------------------------
# 数据库 (PostgreSQL + pgvector)
# ------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=virtual_town
POSTGRES_USER=virtual_town
POSTGRES_PASSWORD=virtual_town_dev
DATABASE_URL=postgresql+asyncpg://virtual_town:virtual_town_dev@postgres:5432/virtual_town
DATABASE_URL_SYNC=postgresql+psycopg://virtual_town:virtual_town_dev@postgres:5432/virtual_town

# 本机直连（不走 Docker 网络时使用）
DATABASE_URL_LOCAL=postgresql+asyncpg://virtual_town:virtual_town_dev@localhost:5432/virtual_town
DATABASE_URL_LOCAL_SYNC=postgresql+psycopg://virtual_town:virtual_town_dev@localhost:5432/virtual_town

# ------------------------------
# Redis
# ------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_URL_LOCAL=redis://localhost:6379/0

# ------------------------------
# LLM (通义千问 DashScope 兼容模式)
# ------------------------------
LLM_PROVIDER=dashscope
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 真实 API Key 仅在本地 .env 配置；切勿提交到代码仓库
LLM_API_KEY=
LLM_CHAT_MODEL=qwen-plus
LLM_REASONING_MODEL=qwen-plus
LLM_EMBEDDING_MODEL=text-embedding-v3
LLM_EMBEDDING_DIM=1024
LLM_CHAT_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# 当 API key 未配置或调用失败时，Agent 会回退到规则行为
LLM_ENABLED=true
# 阶段 17：按任务角色可选不同模型（留空则回退到 chat / reasoning 默认）
# 角色：dialogue / planning / query_rewrite
LLM_DIALOGUE_MODEL=
LLM_PLANNING_MODEL=
LLM_QUERY_REWRITE_MODEL=

# ------------------------------
# LLM Provider — Ollama 本地模型（可选）
# ------------------------------
# 启用 Ollama 本地推理（OpenAI 兼容协议）。OLLAMA_ENABLED=true 且 LLM_PROVIDER_PRIORITY
# 把 ollama 排前时，未配置 LLM_API_KEY 也能跑。
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIM=768
OLLAMA_TIMEOUT_SECONDS=60
# Provider 优先级，逗号分隔，按列表顺序尝试。可选值：dashscope / ollama / mock
LLM_PROVIDER_PRIORITY=dashscope

# ------------------------------
# 阶段 19：社会化升级（请求-同意-拒绝 + NPC-NPC 自主社交）
# ------------------------------
# 社交需求触发阈值（0..100，对应 social_need * 100）：高于此值时 NPC 倾向主动社交
# 阶段 19+++：默认从 55 → 40，让 NPC 更早觉得"该社交了"
SOCIAL_NEED_TRIGGER_THRESHOLD=40
# NPC-NPC 对话最大轮次（任一方调 end_chat 即提前结束）
NPC_DIALOG_MAX_TURNS=10
# 请求 pending 超时（秒）
INTERACTION_REQUEST_TIMEOUT_SECONDS=30
# 被同一对方连续硬拒后冷却的仿真分钟数
SOCIAL_COOLDOWN_AFTER_REFUSAL_MINUTES=30
# 陌生人 / 熟人界限（familiarity 0..1）
INTERACTION_STRANGER_FAMILIARITY_THRESHOLD=0.2
# 高优先级任务阈值（≥ 此值时硬拒绝其他请求）
INTERACTION_HIGH_PRIORITY_THRESHOLD=8

# 阶段 19++ / 20：世界事件 → 记忆投影
# 关闭可彻底跳过投影（压测时减负）
MEMORY_PROJECTION_ENABLED=true
# 不在白名单内的事件，importance ≥ 此阈值才投影
# 阶段 20：默认 4 → 2，让所有 NPC 经历的事件都至少进 working scope（30 分钟过期）。
MEMORY_PROJECTION_DEFAULT_MIN_IMPORTANCE=2
# 默认去重窗口（仿真分钟）：同一 (actor, event_type, target) 内只投影一次
MEMORY_PROJECTION_DEFAULT_DEBOUNCE_MINUTES=30

# 阶段 20：记忆系统重构
# consolidation worker：每仿真日把同主题 archived 记忆合并成一条 long_term summary
MEMORY_CONSOLIDATION_ENABLED=true
# 单主题桶 ≥ 此条数才触发合并（防止过碎）
MEMORY_CONSOLIDATION_MIN_BUCKET_SIZE=3
# 每次合并扫描"过去 N 仿真天"内的 archived 记忆
MEMORY_CONSOLIDATION_LOOKBACK_DAYS=7
# rumination worker：每个 NPC 24 仿真小时回顾重要记忆产生新感悟
MEMORY_RUMINATION_ENABLED=true
# importance ≥ 此值的长期记忆才参与沉思
MEMORY_RUMINATION_IMPORTANCE_THRESHOLD=7
# 单次沉思最多抽多少条候选记忆
MEMORY_RUMINATION_SAMPLE_SIZE=5
# 对话每条消息都为参与者写记忆（关掉则只在对话结束写一条 wrap_up）
MEMORY_DIALOGUE_PER_MESSAGE=true

# 阶段 19+：基础需求自然演化（每仿真分钟增量；0 表示关闭）
# 阶段 19+++ 调参：默认值整体上调，让 NPC 更主动社交 / 用餐 / 休息。
# social_need 0.0030/min → 0 到阈值 0.40 约 130 仿真分钟，节奏接近现实社交需求
NEEDS_SOCIAL_GROWTH_PER_MINUTE=0.0030
NEEDS_HUNGER_GROWTH_PER_MINUTE=0.0020
NEEDS_ENERGY_DECAY_PER_MINUTE=0.0015
# 单次社交完成后社交需求衰减比例
NEEDS_SOCIAL_DECAY_AFTER_CHAT=0.55
# 引擎自主邂逅扫描间隔（仿真分钟），阶段 19+++：5 → 2
SOCIAL_ENCOUNTER_SCAN_MINUTES=2
# 邂逅触发的最大曼哈顿距离，阶段 19+++：3 → 5
SOCIAL_ENCOUNTER_DISTANCE=5
# 同一 NPC 邂逅触发后冷却（仿真分钟），阶段 19+++：20 → 10
SOCIAL_ENCOUNTER_COOLDOWN_MINUTES=10

# ------------------------------
# 仿真
# ------------------------------
# 新游戏 / seed 默认室外地图尺寸（格），对应 GET /api/games/world-defaults
# BUILDING_LAYOUT / HOME_LAYOUT 硬编码坐标要求 width≥120 / height≥90，
# 否则 8 户北/中/南区住宅 + 农场屋 + 木工坊的入口会落在地图外，NPC 永远
# "暂时不可达"。详见 docs/开发手册/debug/20260502-world-bounds-mismatch.md。
WORLD_GEN_OUTDOOR_DEFAULT_WIDTH=120
WORLD_GEN_OUTDOOR_DEFAULT_HEIGHT=90

SIMULATION_WORLD_TICK_HZ=2
# 阶段 19+++：5 → 3，每个 NPC 每 3 仿真分钟决策一次（更灵敏）
SIMULATION_AI_TICK_MINUTES=3
SIMULATION_SPEED_DEFAULT=1
# 默认 false：要求用户从前端「开始页」点击「新游戏」或「读档」后再启动；
# CI / 调试时可置为 true 复用旧世界。
# 历史 bug：仅在「DB 中没有 simulation 行」的首次 seed 生效；后续重启
# 容器，引擎直接复用 DB 残留 status='running'，让本配置等价被绕过。
# 修复后（2026-05），lifespan 启动时无论 DB 状态如何都按本字段收敛 status。
SIMULATION_AUTOSTART=false
# 默认 true：冷启动时清空 RQ 队列里上一进程入队的 pending jobs +
# 把 PG tasks 表里 pending/running 收敛到 cancelled，避免新 worker 把
# 引用了旧 trace_id / simulation_step 的「鬼任务」继续跑出来（从而避免
# failed 任务指标雪崩）。极少数想「重启后接着跑老任务」时才设为 false。
SIMULATION_RESET_QUEUE_ON_START=true
# 默认 true：前端游戏场景 WebSocket（/ws/simulations/{id}）全部断开后，
# 在 ``SIMULATION_AUTO_PAUSE_AFTER_IDLE_SECONDS`` 秒内若仍无人重连，则自动
# ``POST .../pause``。观测台 /ws/observability 不计入「在线」。
# 设为 false：适合无头跑压测 / 自动化；否则玩家离线后仍会消耗 tick / LLM。
SIMULATION_AUTO_PAUSE_WHEN_NO_GAME_WS_CLIENTS=true
# 自动暂停前的空闲秒数（默认 45，最小可设 0 表示立即暂停）
SIMULATION_AUTO_PAUSE_AFTER_IDLE_SECONDS=45

# ------------------------------
# 异步任务队列（阶段 12：Redis + RQ）
# ------------------------------
# async：LLM / embedding / 反思走后台 RQ worker（默认，见 worker 容器）
# sync ：保留 inline LLM 路径，便于回归与调试
TASK_QUEUE_MODE=async
# 队列后端实现（目前只支持 rq；预留 celery 扩展点）
TASK_QUEUE_BACKEND=rq
# RQ 队列名（按优先级切三个，worker 默认按 high → default → low 顺序消费）
TASK_QUEUE_HIGH=vt:high
TASK_QUEUE_DEFAULT=vt:default
TASK_QUEUE_LOW=vt:low
# 单个 worker 容器副本数（扩容直接 ``docker compose up --scale worker=N``）
TASK_QUEUE_WORKER_COUNT=1
# 单 worker 容器内的并发槽位数（阶段 21+：async I/O 并发；默认与 ``session.py`` 池对齐）
# 提到 ≥22 时请同步增大 ``backend/app/db/session.py`` 的 pool_size/max_overflow；
# ``docker compose --scale worker=N`` 时每副本一份池，勿超过 Postgres max_connections。
TASK_QUEUE_WORKER_CONCURRENCY=18
# agent_decision 在队列中等待的 deadline（秒）；略大可减少淤积时的无效丢弃
AGENT_DECISION_DEADLINE_SECONDS=105

# ------------------------------
# 可观测性（阶段 14）
# ------------------------------
# Observer 批量 flush：略拉长间隔 / 增大批量可减少写库开销（Dashboard 略有延迟）
OBSERVABILITY_FLUSH_INTERVAL=2
OBSERVABILITY_BATCH_SIZE=280
# 四类缓冲 deque 总和上限（溢出丢最旧）
OBSERVABILITY_BUFFER_MAX_SIZE=4000

# ------------------------------
# 安全 / 内容安全（阶段 18）
# ------------------------------
# 每个玩家 talk / interact 的固定窗口限流（每秒 1 条）
SECURITY_PLAYER_RATE_LIMIT=1
SECURITY_RATE_WINDOW_SECONDS=1
# 公共 API 每 IP 软限流
SECURITY_IP_RATE_LIMIT=20
SECURITY_IP_RATE_WINDOW_SECONDS=1
# 玩家单条消息最长字符数
SECURITY_MAX_MESSAGE_LENGTH=500
# 工具越权告警阈值与滑窗
SECURITY_TOOL_VIOLATION_THRESHOLD=5
SECURITY_TOOL_VIOLATION_WINDOW_SECONDS=300

# ------------------------------
# 前端
# ------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
# Demo 模式（docker-compose.demo.yml）nginx 对外端口，避免与 dev 模式 5173 冲突
FRONTEND_DEMO_PORT=8080
# NPC 精灵格间 tween 时长（毫秒），40–900；越小越快（vite ``envDir`` 指向仓库根）
VITE_AGENT_MOVE_TWEEN_MS=145
