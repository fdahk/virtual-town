# ============================================================
# AI 小镇 - 环境变量模板
# 使用方法：cp .env.example .env，并按实际情况填写
# 真实密钥禁止提交到仓库
# ============================================================

# ------------------------------
# 应用通用
# ------------------------------
APP_ENV=dev
APP_NAME=virtual-town
APP_LOG_LEVEL=INFO
APP_DEBUG=true

# ------------------------------
# 后端服务
# ------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_PUBLIC_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# ------------------------------
# 数据库 (PostgreSQL + pgvector)
# ------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=virtual_town
POSTGRES_USER=virtual_town
POSTGRES_PASSWORD=virtual_town_dev
DATABASE_URL=postgresql+asyncpg://virtual_town:virtual_town_dev@postgres:5432/virtual_town
DATABASE_URL_SYNC=postgresql+psycopg://virtual_town:virtual_town_dev@postgres:5432/virtual_town

# 本机直连（不走 Docker 网络时使用）
DATABASE_URL_LOCAL=postgresql+asyncpg://virtual_town:virtual_town_dev@localhost:5432/virtual_town
DATABASE_URL_LOCAL_SYNC=postgresql+psycopg://virtual_town:virtual_town_dev@localhost:5432/virtual_town

# ------------------------------
# Redis
# ------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_URL_LOCAL=redis://localhost:6379/0

# ------------------------------
# LLM (通义千问 DashScope 兼容模式)
# ------------------------------
LLM_PROVIDER=dashscope
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-c42c3738c2ed466499f0d67c3f4a5c01
LLM_CHAT_MODEL=qwen-plus
LLM_REASONING_MODEL=qwen-plus
LLM_EMBEDDING_MODEL=text-embedding-v3
LLM_EMBEDDING_DIM=1024
LLM_CHAT_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# 当 API key 未配置或调用失败时，Agent 会回退到规则行为
LLM_ENABLED=false

# ------------------------------
# 仿真
# ------------------------------
SIMULATION_WORLD_TICK_HZ=5
SIMULATION_AI_TICK_MINUTES=5
SIMULATION_SPEED_DEFAULT=1
SIMULATION_AUTOSTART=true

# ------------------------------
# 前端
# ------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
